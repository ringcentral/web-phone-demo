{
  "name": "untitled-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "generate:versions": "node scripts/generate-versions.js",
    "lint": "biome check --write src scripts package.json biome.json",
    "release": "pnpm generate:versions && rm -rf .parcel-cache && parcel build src/index.html src/callback.html --dist-dir docs --public-url ./ && gh-pages -d docs && rm -rf docs",
    "serve": "pnpm generate:versions && rm -rf .parcel-cache && parcel src/index.html src/callback.html --dist-dir temp --no-hmr",
    "postinstall": "pnpm generate:versions"
  },
  "dependencies": {
    "@rc-ex/authorize-uri": "^2.1.1",
    "@rc-ex/core": "^1.8.3",
    "antd": "^6.5.0",
    "hyperid": "^4.0.0",
    "localforage": "^1.10.0",
    "manate": "^2.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ringcentral-web-phone": "^2.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "gh-pages": "^6.3.0",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "svgo": "^4.0.1",
    "timers-browserify": "^2.0.12",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "vm-browserify": "^1.1.2",
    "wait-for-async": "^0.8.1"
  },
  "packageManager": "pnpm@10.34.4",
  "@parcel/resolver-default": {
    "packageExports": true
  }
